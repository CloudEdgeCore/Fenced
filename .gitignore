# Local toolchains and scratch data
/tmp/

# Build and test output
/bin/
/dist/
/coverage/
/target/
*.exe
*.coverprofile
*.test
__pycache__/
*.py[cod]
*.egg-info/
/sdk/python/build/
/sdk/typescript/dist/
/sdk/typescript/node_modules/

# Documentation policy.
# Published: docs/evidence/ — the benchmark and drill reports the Release Gate
# requires to be public, each carrying its own commit SHA and run id.
# Local-only: plans, remediation lists, decision records, and internal status
# notes under docs/internal/ are never pushed.
/docs/*
!/docs/evidence/
!/docs/evidence/**
!/docs/architecture/
!/docs/architecture/**
!/docs/contracts/
!/docs/contracts/**
!/docs/ecosystem/
!/docs/ecosystem/**
!/docs/releases/
!/docs/releases/**
!/docs/feature-status.md
!/docs/user-guide.md
!/docs/development.md
!/docs/NAMING.md
!/docs/COMPATIBILITY.md

# Local-only model endpoints and tenant policy overrides (private infra)
deploy/dev/*.local.json

# Local configuration and credentials
.env
.env.*
!.env.example
agent.yaml
!.agent.yaml.example

# Local binaries
/agent
/agent-linux-amd64
/industrial-demo
/quality-demo
/test-invoke

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local agent workspace (session logs and working memory; developer-specific,
# never part of the build or the shipped product)
.workbuddy-ai/

# TLC scratch
modelcheck/tla/states/
modelcheck/tla/Fenced_TTrace*

research-e2e.log
research-final.log
research-scale.log
research-*.log

# Local acceptance-test captures
/v*-local.log
/v*-full.log

# Generated live acceptance evidence (attach to PR/release; never commit)
/artifacts/research-live/*.json
