{
  "apiVersion": "fenced.dev/v1",
  "kind": "AgentVersion",
  "metadata": { "name": "devops-observer", "version": "1.0.0", "namespace": "default" },
  "spec": {
    "runtimeClassPolicy": { "allowed": ["research-network"], "preferred": "research-network" },
    "lifecycle": { "maxAttempts": 3 },
    "runtimes": [{ "class": "research-network", "interface": "fenced.runtime.interface/v1", "runtimeABI": "fenced.adapter-http/v1", "entrypoint": ["fenced-binding://devops"] }],
    "capabilities": { "tools": ["kubernetes.get@1.0.0", "kubernetes.logs@1.0.0"], "models": ["__MODEL_FAST__"], "memory": ["devops/*"], "secrets": [] },
    "budget": { "tokens": 8000, "costUsd": 1.20, "toolCalls": 16, "wallSeconds": 300 },
    "checkpoint": { "mode": "logical", "schemaVersion": "devops/v1", "intervalSeconds": 30 }
  }
}
