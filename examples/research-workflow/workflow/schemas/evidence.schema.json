{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenced.dev/schemas/research/evidence.schema.json",
  "title": "EvidenceBundle",
  "description": "One Reader Agent's extraction for one source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceId", "researchQuestionId", "title", "url", "claims"],
  "properties": {
    "sourceId": { "type": "string", "pattern": "^src-[0-9]{3}$" },
    "researchQuestionId": { "type": "string", "pattern": "^rq-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "claims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "claim", "evidence", "confidence"],
      "properties": {
        "claimId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-claim-[0-9]{3}$" },
        "claim": { "type": "string", "minLength": 8, "maxLength": 1024 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
