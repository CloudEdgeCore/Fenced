{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenced.dev/schemas/research/analysis.schema.json",
  "title": "Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "contradictions", "unknowns"],
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/finding" }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/contradiction" }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 512 }
    },
    "passthrough": {
      "type": "boolean",
      "description": "True when this round carried the previous analysis forward without a model call."
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "statement", "evidenceIds", "confidence"],
      "properties": {
        "findingId": { "type": "string", "pattern": "^finding-[0-9]{3}$" },
        "statement": { "type": "string", "minLength": 8, "maxLength": 1024 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-claim-[0-9]{3}$" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "evidenceIds"],
      "properties": {
        "topic": { "type": "string", "maxLength": 512 },
        "evidenceIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string" }
        }
      }
    }
  }
}
