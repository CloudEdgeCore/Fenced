{
  "apiVersion": "fenced.dev/v1",
  "kind": "AgentVersion",
  "metadata": { "name": "research-reader", "version": "1.0.0", "namespace": "default" },
  "spec": {
    "runtimeClassPolicy": { "allowed": ["research-sandbox"], "preferred": "research-sandbox" },
    "lifecycle": { "maxAttempts": 3 },
    "runtimes": [{ "class": "research-sandbox", "interface": "fenced.runtime.interface/v1", "runtimeABI": "fenced.adapter-http/v1", "entrypoint": ["fenced-binding://research"] }],
    "capabilities": {
      "tools": ["web.fetch@1.0.0"],
      "models": ["__MODEL_READER__"],
      "memory": ["research/*"],
      "secrets": []
    },
    "budget": { "tokens": 8000, "costUsd": 1.20, "toolCalls": 8, "wallSeconds": 300 },
    "checkpoint": { "mode": "logical", "schemaVersion": "research/v1", "intervalSeconds": 30 }
  }
}
