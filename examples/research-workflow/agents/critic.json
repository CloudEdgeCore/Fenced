{
  "apiVersion": "fenced.dev/v1",
  "kind": "AgentVersion",
  "metadata": { "name": "research-critic", "version": "1.0.0", "namespace": "default" },
  "spec": {
    "runtimeClassPolicy": { "allowed": ["research-reasoning"], "preferred": "research-reasoning" },
    "lifecycle": { "maxAttempts": 4 },
    "runtimes": [{ "class": "research-reasoning", "interface": "fenced.runtime.interface/v1", "runtimeABI": "fenced.adapter-http/v1", "entrypoint": ["fenced-binding://research"] }],
    "capabilities": {
      "tools": [],
      "models": ["__MODEL_REASONING__"],
      "memory": ["research/*"],
      "secrets": [],
      "spawnTasks": true,
      "childAgents": ["research-search@1.0.0"]
    },
    "budget": { "tokens": 20000, "costUsd": 3.00, "toolCalls": 12, "wallSeconds": 600 },
    "checkpoint": { "mode": "logical", "schemaVersion": "research/v1", "intervalSeconds": 30 }
  }
}
