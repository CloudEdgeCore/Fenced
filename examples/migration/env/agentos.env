# /etc/agentos/control.env — BEFORE the rename.
#
# This mirrors what deploy/helm/fenced/templates/deployment-control.yaml
# injects into the Control API, plus the worker-facing variables. Values shown
# as <secret:…> are supplied by your secrets manager; they are never committed.
#
# The migrated counterpart is env/fenced.env.

# --- Unchanged by the rename: this variable has no product prefix ---
DATABASE_URL=postgres://fenced:change-me@127.0.0.1:5432/fenced?sslmode=disable

# --- Renamed AGENTOS_* -> FENCED_* ---
# Key material (Helm: security.audit.existingSecret, security.packageTrust.existingSecret)
AGENTOS_AUDIT_SIGNING_KEY=<secret:control-plane-audit>
AGENTOS_PACKAGE_TRUST_KEYS=<secret:package-trust-keys>

# Optional embedding provider token (Helm: embedding.tokenSecret)
AGENTOS_EMBEDDING_TOKEN=<secret:embedding-token>

# Worker-facing: where the Control API lives and who the worker claims to be.
AGENTOS_CONTROL_URL=http://127.0.0.1:8080
AGENTOS_TOKEN=<secret:control-api-token>
AGENTOS_TENANT_ID=default
