# /etc/fenced/control.env — AFTER the rename.
#
# This is env/agentos.env with exactly one mechanical change: the AGENTOS_
# prefix becomes FENCED_. DATABASE_URL is untouched because it never carried
# the product prefix.
#
# Because fenced-control aliases legacy AGENTOS_* names at start-up, this file
# and env/agentos.env are interchangeable during the transition: either works
# against the new binary. The difference is only that the legacy names make the
# binary print one deprecation notice per start.

# --- Unchanged by the rename: this variable has no product prefix ---
DATABASE_URL=postgres://fenced:change-me@127.0.0.1:5432/fenced?sslmode=disable

# --- Renamed AGENTOS_* -> FENCED_* ---
# Key material (Helm: security.audit.existingSecret, security.packageTrust.existingSecret)
FENCED_AUDIT_SIGNING_KEY=<secret:control-plane-audit>
FENCED_PACKAGE_TRUST_KEYS=<secret:package-trust-keys>

# Optional embedding provider token (Helm: embedding.tokenSecret)
FENCED_EMBEDDING_TOKEN=<secret:embedding-token>

# Worker-facing: where the Control API lives and who the worker claims to be.
FENCED_CONTROL_URL=http://127.0.0.1:8080
FENCED_TOKEN=<secret:control-api-token>
FENCED_TENANT_ID=default
