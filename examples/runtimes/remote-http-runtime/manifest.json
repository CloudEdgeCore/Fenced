{
  "schema": "fenced.dev/v1",
  "name": "remote-http-runtime",
  "version": "1.0.0",
  "runtime": {
    "provider": "remote-http",
    "protocolVersion": "fenced.runtime.interface/v1",
    "endpoint": "http://127.0.0.1:8086",
    "conformance": {
      "certified": true,
      "checks": ["health", "start", "event", "result", "checkpoint", "restore", "stop"]
    }
  },
  "resources": {
    "cpu": "250m",
    "memory": "256Mi"
  }
}
